# Copy this file to .env for local runs (never commit the real .env).
# In GitHub Actions, set these as repository secrets instead.

# Amadeus for Developers (developers.amadeus.com) — Self-Service API key/secret.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Google Flights needs no credentials — it's scraped directly via the
# fast-flights library (see sources.google_flights in config.yaml).

# Gmail address used to send alert emails, and an App Password for it
# (Google Account -> Security -> 2-Step Verification -> App passwords).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Where alert emails should be delivered.
ALERT_EMAIL_TO=bhatiahardik111@gmail.com
